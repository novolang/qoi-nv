// qoi.nv — the fourteen-byte header, the two enumerations in it, and
// the size arithmetic a caller needs before allocating anything.
//
// The QOI specification is one page: six opcodes, one header, one end
// marker and no options.  This package covers all of it.
//
//     0..4    magic, the four ASCII bytes `qoif`
//     4..8    width in pixels, unsigned 32-bit big-endian
//     8..12   height in pixels, unsigned 32-bit big-endian
//     12      channels: 3 or 4
//     13      colorspace: 0 or 1
//
// The dimensions are big-endian, whatever the machine.  The colorspace
// byte is purely informative (QOI specification, "qoi_header"): it
// changes nothing about how an opcode is encoded or decoded, and is
// carried so that a round trip keeps it.
//
// No function here has an effect.

// How many channels a QOI file's pixels carry.
//
// Three or four; the decoder refuses any other value.  The byte
// describes the file's contents rather than its encoding: the opcodes
// are the same either way, and a three-channel file never changes alpha
// from 255.
//
// ```novo
// use qoi
//
// fn main() [io]
//     println("${qoi.channel_count(QoiRgba)}")             // 4
// ```
pub enum QoiChannels
    // Three channels: every pixel is opaque and alpha is never coded.
    QoiRgb
    // Four channels: alpha is coded and may vary.
    QoiRgba

// Which colour space the file's channels are in, informatively.
//
// The specification says this byte changes nothing about the encoding,
// so this package only carries it through a round trip.  A caller who
// wants to act on it converts with color-nv.
//
// ```novo
// use qoi
//
// fn main() [io]
//     println("${qoi.space_byte(QoiAllLinear)}")           // 1
// ```
pub enum QoiSpace
    // 0: sRGB channels with a linear alpha.  What almost every file
    // says, and what a screenshot or a photograph is.
    QoiSrgbLinearAlpha
    // 1: all channels linear.  What a normal map, a height field or a
    // light probe is.
    QoiAllLinear

// The fourteen-byte header of a QOI file, as a value.
//
// A plain struct rather than an unboxed one because it is a `Result`
// payload in `read_header` and a tuple element in `decode`, and SPEC
// § 14.5 admits an unboxed struct in neither position.
//
// ```novo
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 2, height: 2, channels: QoiRgba, space: QoiSrgbLinearAlpha }
//     println("${qoi.pixel_count(h)}")                     // 4
// ```
pub struct QoiHeader
    // Width in pixels.  The decoder refuses zero.
    width: Int
    // Height in pixels.  The decoder refuses zero.
    height: Int
    // Three channels or four.
    channels: QoiChannels
    // The informative colour space byte.
    space: QoiSpace

// The four ASCII bytes every QOI file starts with.
//
// `qoif`.  A caller sniffing a file's format reads it here rather than
// spelling it again.
//
// ```novo
// use qoi
//
// fn main() [io]
//     println("${bytes.len(qoi.magic())}")                 // 4
// ```
pub fn magic() -> Bytes
    bytes.from_str("qoif")

// Whether a buffer starts with QOI's magic.
//
// It reads four bytes and says nothing about the rest of the file;
// `qoidec.read_header` and the decoder check that.  A buffer shorter
// than four bytes answers false.
//
// ```novo
// use qoi
//
// fn main() [io]
//     let head = bytes.from_str("qoif")
//     println("${qoi.is_qoi(head)}")                       // true
// ```
pub fn is_qoi(src: Bytes) -> Bool
    if bytes.len(src) < 4
        return false
    bytes.slice(src, 0, 4) == magic()

// The eight bytes every QOI file ends with.
//
// Seven zero bytes and then a one.  The decoder expects it right after
// the last pixel, which is what tells a whole file from one cut off
// after an opcode that happened to complete.
//
// ```novo
// use qoi
//
// fn main() [io]
//     println("${bytes.len(qoi.end_marker())}")            // 8
// ```
pub fn end_marker() -> Bytes
    bytes.from_byte_list([0, 0, 0, 0, 0, 0, 0, 1])

// How many bytes a header occupies: 14, always.
//
// A function, so that the layout is stated in one place.
//
// ```novo
// use qoi
//
// fn main() [io]
//     println("${qoi.header_size()}")                      // 14
// ```
pub fn header_size() -> Int
    14

// The channel count as an integer: 3 or 4.
//
// ```novo
// use qoi
//
// fn main() [io]
//     println("${qoi.channel_count(QoiRgb)}")              // 3
// ```
pub fn channel_count(c: QoiChannels) -> Int
    match c
        QoiRgb  => 3
        QoiRgba => 4

// The colour space as the byte the file carries: 0 or 1.
//
// ```novo
// use qoi
//
// fn main() [io]
//     println("${qoi.space_byte(QoiSrgbLinearAlpha)}")     // 0
// ```
pub fn space_byte(s: QoiSpace) -> Int
    match s
        QoiSrgbLinearAlpha => 0
        QoiAllLinear       => 1

// How many pixels a header describes.
//
// `width * height`.  The decoder refuses a header of 400,000,000 pixels
// or more, the limit of the reference implementation, so the product
// and every size computed from it fit in an `Int`.
//
// ```novo
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 3, height: 4, channels: QoiRgb, space: QoiAllLinear }
//     println("${qoi.pixel_count(h)}")                     // 12
// ```
pub fn pixel_count(h: QoiHeader) -> Int
    h.width * h.height

// How many bytes the decoded pixels occupy at the header's channel
// count.
//
// `width * height * channels`: the size of the buffer a whole-image
// decode answers.
//
// ```novo
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 2, height: 2, channels: QoiRgba, space: QoiAllLinear }
//     println("${qoi.decoded_size(h)}")                    // 16
// ```
pub fn decoded_size(h: QoiHeader) -> Int
    pixel_count(h) * channel_count(h.channels)

// The largest a QOI file of these dimensions can be.
//
// `14 + width * height * (channels + 1) + 8`.  The worst case is one
// literal per pixel: five bytes for four channels, four for three.  A
// caller sizes the encoder's buffer with this, encodes, and keeps the
// prefix the encoder says it filled.
//
// ```novo
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 1, height: 1, channels: QoiRgba, space: QoiAllLinear }
//     println("${qoi.max_encoded_size(h)}")                // 27
// ```
pub fn max_encoded_size(h: QoiHeader) -> Int
    header_size() + pixel_count(h) * (channel_count(h.channels) + 1) + 8

// Write a header into a caller-supplied buffer at an offset.
//
// The fourteen bytes are written into `out` itself, which the caller
// passes as a `var` name or a new buffer.  The answer is that buffer and
// the offset past the header.
//
// ```novo
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 1, height: 1, channels: QoiRgb, space: QoiAllLinear }
//     let (buf, at) = qoi.write_header(h, bytes.zeros(14), 0)
//     println("${at}")                                     // 14
// ```
pub fn write_header(h: QoiHeader, var out: Bytes, at: Int) -> (Bytes, Int)
    bytes.copy_into(out, at, magic(), 0, 4)
    bytes.set_u32_be(out, at + 4, h.width)
    bytes.set_u32_be(out, at + 8, h.height)
    bytes.set_u8(out, at + 12, channel_count(h.channels))
    bytes.set_u8(out, at + 13, space_byte(h.space))
    (out, at + 14)
