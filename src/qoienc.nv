// qoienc.nv — the encoder: pixels in, bytes out into a buffer the
// caller supplies.
//
// `qoi.max_encoded_size` is the most a file of given dimensions can
// take, so the caller can size the buffer before encoding.  A caller
// encoding many frames allocates once, and one writing into the middle
// of a larger buffer needs no copy afterwards.  `start`, `push`,
// `push_samples` and `finish` write into the caller's buffer, which the
// caller passes as a `var` name, and answer the offset past what they
// wrote.
//
// A run spans pixels, so `push` holds a run open and writes it when it
// reaches 62 pixels, when a different pixel arrives, or when the
// image's last pixel does.  `push` therefore often writes nothing.
// `finish` writes the end marker.
//
// The specification fixes the preference order, index, then diff, then
// luma, then a literal, so two conforming encoders write the same bytes
// for the same pixels.  This encoder writes the bytes the reference
// implementation writes.
//
// No function here has an effect.

use qoi
use qoiop
use qoidec
use qoierror
use srgb

// An encoder between pixels.
//
// Each call answers a new encoder and leaves the one it was given as it
// was.  A failed encoder stays failed, and every later call writes
// nothing.
//
// ```novo
// use qoienc
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 1, height: 1, channels: QoiRgba, space: QoiAllLinear }
//     println("${qoienc.total_in(qoienc.encoder(h))}")     // 0
// ```
pub struct QoiEncoder
    // The header this encoder is writing a body for.  Fixed for its
    // life: the dimensions decide how many pixels `finish` expects.
    head: QoiHeader
    // The previous pixel.  It starts as opaque black, the table as
    // transparent black.
    prev: Srgba8
    // The sixty-four-entry table.
    seen: QoiRunning
    // Pixels taken so far.
    consumed: Int
    // Bytes written so far, header included.
    produced: Int
    // How long the run currently open is, `0 ..= 62`.  A run of 62 is
    // written immediately because 63 does not exist.
    run_open: Int
    // The sticky failure, or absent.
    failure: ?QoiError

// What a write left behind: the encoder to use next, the buffer, and
// where the next byte goes.
//
// `buf` is the caller's own buffer, so a caller holding it under another
// name may keep passing that name instead.
//
// ```novo
// use qoienc
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 1, height: 1, channels: QoiRgb, space: QoiAllLinear }
//     var w = qoienc.start(qoienc.encoder(h), bytes.zeros(32), 0)
//     println("${w.at}")                                   // 14
// ```
pub struct QoiWrite
    // The encoder to hand the next pixel to.
    enc: QoiEncoder
    // The buffer, with whatever was written in it.  It is the buffer
    // the caller passed, not a copy.
    var buf: Bytes
    // The offset the next byte goes at.
    at: Int

// An encoder for an image of these dimensions.
//
// Nothing is written yet; `start` writes the header.  A caller writing
// a body into a file that already has a header skips `start`.  A
// three-channel header makes every pixel opaque, whatever its alpha, so
// the file stays within `qoi.max_encoded_size`.
//
// ```novo
// use qoienc
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 4, height: 4, channels: QoiRgba, space: QoiSrgbLinearAlpha }
//     println("${qoienc.total_out(qoienc.encoder(h))}")    // 0
// ```
pub fn encoder(h: QoiHeader) -> QoiEncoder
    QoiEncoder { head: h, prev: srgb.opaque(srgb.black()), seen: qoiop.running_new(),
                 consumed: 0, produced: 0, run_open: 0, failure: None }

// Write the fourteen-byte header into the buffer.
//
// The bytes go into `out` itself.  A buffer too short for them fails
// the encoder with `QoiBufferTooSmall`.
//
// ```novo
// use qoienc
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 2, height: 2, channels: QoiRgb, space: QoiAllLinear }
//     var w = qoienc.start(qoienc.encoder(h), bytes.zeros(64), 0)
//     println("${w.at}")                                   // 14
// ```
pub fn start(e: QoiEncoder, var out: Bytes, at: Int) -> QoiWrite
    var s = open_work(e)
    var next = at
    if at + qoi.header_size() > bytes.len(out)
        s.fail = Some(QoiBufferTooSmall(at, qoi.max_encoded_size(e.head), bytes.len(out)))
    else
        qoi.write_header(e.head, out, at)
        s.produced = s.produced + qoi.header_size()
        next = at + qoi.header_size()
    QoiWrite { enc: close_work(e, s), buf: out, at: next }

// Hand the encoder one pixel.
//
// A pixel equal to the one before it extends the open run and writes
// nothing; the run is written when it reaches 62, when a different
// pixel arrives, or with the image's last pixel.  So `w.at` standing
// still is not an error.
//
// Pixels come in raster order, left to right and top to bottom, which
// is the only order QOI has.
//
// ```novo
// use qoienc
// use qoi
// use srgb
//
// fn main() [io]
//     let h = QoiHeader { width: 1, height: 1, channels: QoiRgba, space: QoiAllLinear }
//     var w = qoienc.start(qoienc.encoder(h), bytes.zeros(64), 0)
//     let w2 = qoienc.push(w.enc, srgb.opaque(srgb.white()), w.buf, w.at)
//     println("${qoienc.total_in(w2.enc)}")                // 1
// ```
pub fn push(e: QoiEncoder, px: Srgba8, var out: Bytes, at: Int) -> QoiWrite
    var s = open_work(e)
    let next = put_pixel(s, e.head, out, at, qoiop.pack(px))
    QoiWrite { enc: close_work(e, s), buf: out, at: next }

// Hand the encoder a whole row of packed samples.
//
// The bulk form, for a caller who has an image as a flat buffer rather
// than as pixel values.
// `channels` says how the samples are packed, 3 or 4, and need not
// match the header's: three-channel samples are taken as opaque.  Any
// other count fails the encoder with `QoiBadChannels`.  Bytes after the
// last whole pixel of the row are ignored.
//
// ```novo
// use qoienc
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 1, height: 1, channels: QoiRgb, space: QoiAllLinear }
//     var w = qoienc.start(qoienc.encoder(h), bytes.zeros(64), 0)
//     let w2 = qoienc.push_samples(w.enc, bytes.zeros(3), 3, w.buf, w.at)
//     println("${qoienc.total_in(w2.enc)}")                // 1
// ```
pub fn push_samples(e: QoiEncoder, row: Bytes, channels: Int, var out: Bytes, at: Int) -> QoiWrite
    var s = open_work(e)
    var next = at
    if s.fail == None and channels != 3 and channels != 4
        s.fail = Some(QoiBadChannels(at, channels))
    var i = 0
    let n = bytes.len(row)
    while s.fail == None and i + channels <= n
        let a = if channels == 4
            qoiop.byte(row, i + 3)
        else
            255
        let px = (qoiop.byte(row, i) << 24) | (qoiop.byte(row, i + 1) << 16)
                 | (qoiop.byte(row, i + 2) << 8) | a
        next = put_pixel(s, e.head, out, next, px)
        i = i + channels
    QoiWrite { enc: close_work(e, s), buf: out, at: next }

// Close the file with the eight-byte end marker, and answer the buffer
// and the offset past the marker.
//
// `Err` with the encoder's failure if it has one, with
// `QoiTruncatedStream` when fewer pixels arrived than the header
// promised, and with `QoiBufferTooSmall` when the marker does not fit.
//
// ```novo
// use qoienc
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 1, height: 1, channels: QoiRgb, space: QoiAllLinear }
//     var w = qoienc.start(qoienc.encoder(h), bytes.zeros(64), 0)
//     match qoienc.finish(w.enc, w.buf, w.at)
//         Ok(_)  => println("closed")
//         Err(_) => println("wrong number of pixels")      // this one
// ```
pub fn finish(e: QoiEncoder, var out: Bytes, at: Int) -> Result<(Bytes, Int), QoiError>
    if let Some(f) = e.failure
        return Err(f)
    let total = qoi.pixel_count(e.head)
    if e.consumed != total
        return Err(QoiTruncatedStream(at, total, e.consumed))
    if at + 8 > bytes.len(out)
        return Err(QoiBufferTooSmall(at, qoi.max_encoded_size(e.head), bytes.len(out)))
    bytes.copy_into(out, at, qoi.end_marker(), 0, 8)
    Ok((out, at + 8))

// The sticky failure, if the encoder has one.
//
// `QoiBufferTooSmall` when the buffer ran out, `QoiOutputTooLarge` for
// a pixel past the header's count, and `QoiBadChannels` for samples
// packed in a count other than 3 or 4.  Every pixel has an encoding, so
// nothing else can fail.
//
// ```novo
// use qoienc
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 1, height: 1, channels: QoiRgb, space: QoiAllLinear }
//     match qoienc.error(qoienc.encoder(h))
//         Some(_) => println("already bad")
//         None    => println("clean")                      // this one
// ```
pub fn error(e: QoiEncoder) -> ?QoiError
    e.failure

// How many pixels have been pushed.
//
// ```novo
// use qoienc
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 1, height: 1, channels: QoiRgb, space: QoiAllLinear }
//     println("${qoienc.total_in(qoienc.encoder(h))}")     // 0
// ```
pub fn total_in(e: QoiEncoder) -> Int
    e.consumed

// How many bytes have been written, header included.
//
// `finish`'s answered offset is the number a caller trims to.
//
// ```novo
// use qoienc
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 1, height: 1, channels: QoiRgb, space: QoiAllLinear }
//     println("${qoienc.total_out(qoienc.encoder(h))}")    // 0
// ```
pub fn total_out(e: QoiEncoder) -> Int
    e.produced

// Encode a whole image held in memory.
//
// The counterpart of `qoidec.decode`: a header and a flat buffer of
// samples in the header's channel count, and the file comes back sized
// to what was written.  It allocates its own buffer.
//
// `Err` for a header with no pixels or too many, and for samples that
// are not exactly the header's pixel count.
//
// ```novo
// use qoienc
// use qoi
//
// fn main() [io]
//     let h = QoiHeader { width: 1, height: 1, channels: QoiRgb, space: QoiAllLinear }
//     match qoienc.encode(h, bytes.zeros(3))
//         Ok(_)  => println("encoded")                     // this one
//         Err(_) => println("refused")
// ```
pub fn encode(h: QoiHeader, samples: Bytes) -> Result<Bytes, QoiError>
    qoidec.check_size(h.width, h.height)!
    let ch = qoi.channel_count(h.channels)
    let total = qoi.pixel_count(h)
    let n = bytes.len(samples)
    if n < total * ch
        return Err(QoiTruncatedStream(n, total, n / ch))
    if n > total * ch
        return Err(QoiOutputTooLarge(total * ch, total))
    var out = bytes.zeros(qoi.max_encoded_size(h))
    let w0 = start(encoder(h), out, 0)
    let w1 = push_samples(w0.enc, samples, ch, out, w0.at)
    let (_, end) = finish(w1.enc, out, w1.at)!
    Ok(bytes.slice(out, 0, end))

// The encoder's working state: the table and the previous pixel packed
// one integer a pixel, and the counts.  `open_work` unpacks an encoder
// into it and `close_work` packs it back, once a call.
struct EncodeWork
    var table: [Int]
    var prev: Int
    var consumed: Int
    var produced: Int
    var run: Int
    var fail: ?QoiError

fn open_work(e: QoiEncoder) -> EncodeWork
    EncodeWork { table: list.map(e.seen.seen, qoiop.pack), prev: qoiop.pack(e.prev),
           consumed: e.consumed, produced: e.produced, run: e.run_open, fail: e.failure }

fn close_work(e: QoiEncoder, w: EncodeWork) -> QoiEncoder
    QoiEncoder { head: e.head, prev: qoiop.unpack(w.prev),
                 seen: QoiRunning { seen: list.map(w.table, qoiop.unpack) }, consumed: w.consumed,
                 produced: w.produced, run_open: w.run, failure: w.fail }

// Writes one opcode at `at` and answers the offset past it, or keeps
// the offset and records the failure when the buffer is too short.
fn put_op(var w: EncodeWork, h: QoiHeader, var out: Bytes, at: Int, op: QoiOp) -> Int
    let size = qoiop.op_size(op)
    if at + size > bytes.len(out)
        w.fail = Some(QoiBufferTooSmall(at, qoi.max_encoded_size(h), bytes.len(out)))
        return at
    qoiop.write_op(op, out, at)
    w.produced = w.produced + size
    at + size

// Takes one packed pixel, made opaque for a three-channel image.  A
// pixel equal to the previous one extends
// the run, which is written when it reaches 62 or the image ends.  Any
// other pixel writes the open run and then its own opcode.  The table
// is written only when the pixel is not already in it, which is what the
// reference encoder does, so the bytes are the same.
fn put_pixel(var w: EncodeWork, h: QoiHeader, var out: Bytes, at: Int, given: Int) -> Int
    let total = qoi.pixel_count(h)
    let px = if h.channels == QoiRgb
        given | 255
    else
        given
    if w.fail != None
        return at
    if w.consumed >= total
        w.fail = Some(QoiOutputTooLarge(at, total))
        return at
    w.consumed = w.consumed + 1
    var next = at
    if px == w.prev
        w.run = w.run + 1
        if w.run == 62 or w.consumed == total
            next = put_op(w, h, out, next, QoiOpRun(w.run))
            w.run = 0
        return next
    if w.run > 0
        next = put_op(w, h, out, next, QoiOpRun(w.run))
        w.run = 0
    let at_hash = qoiop.hash_packed(px)
    let in_table = w.table[at_hash] == px
    if not in_table
        w.table[at_hash] = px
    let prev = w.prev
    w.prev = px
    put_op(w, h, out, next, qoiop.choose_packed(px, prev, in_table))
