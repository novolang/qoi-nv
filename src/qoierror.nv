// qoierror.nv — every way a QOI file can refuse to be read or written,
// and where.
//
// Every variant carries a byte offset counted from the first byte of
// the file, across every chunk a caller fed.
//
// All 256 byte values are valid opcodes, so a corrupt QOI file usually
// decodes to a plausible image rather than to an error.  The pixel count
// and the end marker are the format's only integrity checks, and
// neither is a checksum.
//
// The variants are prefixed `Qoi` because a variant name resolves across
// the whole program, so an unprefixed name would collide with the next
// codec's.

// Why a QOI file could not be read, or written.
//
// ```novo
// use qoierror
//
// fn main() [io]
//     println("${qoierror.offset_of(QoiBadMagic(0, 0))}")      // 0
// ```
pub enum QoiError
    // The first four bytes were not `qoif`.  `saw` is the 32-bit value
    // that was there, so a caller can recognise the common
    // near-misses: a PNG signature, a JPEG marker, HTML from a proxy.
    QoiBadMagic(offset: Int, saw: Int)
    // The channels byte was not 3 or 4.  The encoder reports samples
    // packed in another count with this variant too, at the offset the
    // row would have been written from.
    QoiBadChannels(offset: Int, saw: Int)
    // The colorspace byte was not 0 or 1.  The byte changes nothing
    // about decoding, and is refused anyway: a file that disagrees with
    // the specification there was not written by a QOI encoder.
    QoiBadColorspace(offset: Int, saw: Int)
    // A width or height of zero, which leaves no pixel for a body to
    // code.
    QoiZeroDimension(offset: Int, width: Int, height: Int)
    // Dimensions of 400,000,000 pixels or more, the limit of the
    // reference implementation.  Below it every size this package
    // computes fits in an `Int`.
    QoiTooManyPixels(offset: Int, width: Int, height: Int)
    // Fewer than fourteen bytes: the header itself was cut short.
    QoiTruncatedHeader(offset: Int, len: Int)
    // The stream ended in the middle of an opcode, or before the
    // header's pixel count was reached.  `want` is how many pixels the
    // header promised and `got` how many arrived.  The encoder reports
    // pixels or samples short of the header's count with this variant
    // too.
    QoiTruncatedStream(offset: Int, want: Int, got: Int)
    // The pixel count was reached and the eight-byte end marker did not
    // follow.  The pixels are all present, so the image is complete and
    // the file is not.
    QoiMissingEndMarker(offset: Int)
    // Bytes after the end marker.  QOI has no concatenated members, so
    // anything after the marker means the file is not what it claims.
    QoiTrailingBytes(offset: Int, count: Int)
    // More pixels than the header promised: a run in the file that
    // passes the pixel count, or a pixel or sample pushed to an encoder
    // that already has them all.  The decoder stops at the promised
    // count, so its output never grows past the header's size.
    QoiOutputTooLarge(offset: Int, cap: Int)
    // The encoder's output buffer ran out.  `need` is the size
    // `qoi.max_encoded_size` gives and `have` is the buffer's length.  A
    // caller who sized the buffer with that function cannot reach
    // this.
    QoiBufferTooSmall(offset: Int, need: Int, have: Int)

// The rule every `QoiError` is printed by: what was found, and the
// byte it was found at.  `Result<T, QoiError>` requires the impl (SPEC
// section 3.4).
impl Error for QoiError
    fn message(self) -> Str
        match self
            QoiBadMagic(at, saw)              =>
                "the file starts with ${saw} rather than the magic qoif, at byte ${at}"
            QoiBadChannels(at, saw)           =>
                "the channels byte is ${saw} rather than 3 or 4, at byte ${at}"
            QoiBadColorspace(at, saw)         =>
                "the colour space byte is ${saw} rather than 0 or 1, at byte ${at}"
            QoiZeroDimension(at, w, h)        =>
                "the image is ${w} by ${h} pixels, which holds none, at byte ${at}"
            QoiTooManyPixels(at, w, h)        =>
                "the image is ${w} by ${h} pixels, more than 400000000, at byte ${at}"
            QoiTruncatedHeader(at, len)       =>
                "the header is ${len} bytes rather than 14, at byte ${at}"
            QoiTruncatedStream(at, want, got) =>
                "the stream ends after ${got} of ${want} pixels, at byte ${at}"
            QoiMissingEndMarker(at)           =>
                "the end marker is missing at byte ${at}"
            QoiTrailingBytes(at, count)       =>
                "${count} bytes follow the end marker, at byte ${at}"
            QoiOutputTooLarge(at, cap)        =>
                "the stream codes more than its ${cap} pixels, at byte ${at}"
            QoiBufferTooSmall(at, need, have) =>
                "the buffer holds ${have} bytes and the image may need ${need}, at byte ${at}"

// The 0-based offset into the file the error is about.
//
// Every variant has one.
//
// ```novo
// use qoierror
//
// fn main() [io]
//     println("${qoierror.offset_of(QoiMissingEndMarker(1024))}")  // 1024
// ```
pub fn offset_of(e: QoiError) -> Int
    match e
        QoiBadMagic(at, _)           => at
        QoiBadChannels(at, _)        => at
        QoiBadColorspace(at, _)      => at
        QoiZeroDimension(at, _, _)   => at
        QoiTooManyPixels(at, _, _)   => at
        QoiTruncatedHeader(at, _)    => at
        QoiTruncatedStream(at, _, _) => at
        QoiMissingEndMarker(at)      => at
        QoiTrailingBytes(at, _)      => at
        QoiOutputTooLarge(at, _)     => at
        QoiBufferTooSmall(at, _, _)  => at

// Whether the pixels decoded so far are usable despite the error.
//
// True for `QoiMissingEndMarker` and `QoiTrailingBytes`, where the image
// is complete and the framing around it is not, and false for every
// other error.  QOI has no checksum, so this is all a decoder can say
// about a damaged file.
//
// ```novo
// use qoierror
//
// fn main() [io]
//     println("${qoierror.image_is_complete(QoiMissingEndMarker(8))}")  // true
// ```
pub fn image_is_complete(e: QoiError) -> Bool
    match e
        QoiMissingEndMarker(_) => true
        QoiTrailingBytes(_, _) => true
        _                      => false
