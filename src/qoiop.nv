// qoiop.nv — the six opcodes and the sixty-four-entry running array.
//
// A QOI body is a sequence of opcodes, each producing one or more
// pixels from the pixel before it and a table of sixty-four recently
// seen pixels.  Four opcodes are tagged by their top two bits and carry
// six bits of payload; two are tagged by all eight bits:
//
//     00xxxxxx  QoiOpIndex  the pixel at table position xxxxxx
//     01rrggbb  QoiOpDiff   each channel -2..1, biased by 2
//     10gggggg  QoiOpLuma   green -32..31, then a byte of dr-dg, db-dg
//     11xxxxxx  QoiOpRun    xxxxxx + 1 copies of the last pixel
//     11111110  QoiOpRgb    three literal bytes
//     11111111  QoiOpRgba   four literal bytes
//
// `11111110` and `11111111` would otherwise be runs of 63 and 64, so a
// run stops at 62.
//
// The table is addressed by a hash of the pixel,
// `(r*3 + g*5 + b*7 + a*11) % 64`, not by recency.  It starts as
// sixty-four fully transparent pixels, (0,0,0,0), while the previous
// pixel starts as opaque black, (0,0,0,255).
//
// Channel differences wrap at 256, as they do in the reference
// implementation: a red going from 255 to 0 is a difference of 1.
//
// No function here has an effect.

use srgb

// One decoded opcode: which one it was, and what it carried.
//
// `read_op` produces one and `write_op` writes one, so that a caller
// writing their own loop, such as a file inspector or a transcoder that
// rewrites runs, works in the format's vocabulary rather than in bit
// masks.  The decoder and the encoder work on the bytes directly.
//
// ```novo
// use qoiop
//
// fn main() [io]
//     println("${qoiop.op_name(QoiOpRun(3))}")             // run
// ```
pub enum QoiOp
    // `00xxxxxx` — the pixel currently at table position `at`,
    // `0 ..= 63`.
    QoiOpIndex(at: Int)
    // `01rrggbb` — each channel moved by `-2 ..= 1`, alpha unchanged.
    // The values are the signed differences, already unbiased.
    QoiOpDiff(dr: Int, dg: Int, db: Int)
    // `10gggggg` plus one byte — green moved by `-32 ..= 31`, red and
    // blue by that plus `-8 ..= 7` each, alpha unchanged.  `dr` and
    // `db` are the channels' own differences, not the `dr - dg` and
    // `db - dg` the second byte carries.
    QoiOpLuma(dr: Int, dg: Int, db: Int)
    // `11xxxxxx` — `run` more copies of the previous pixel, `1 ..= 62`.
    // 63 and 64 do not exist: their encodings are `QoiOpRgb` and
    // `QoiOpRgba`.
    QoiOpRun(run: Int)
    // `11111110` plus three bytes — a literal colour, alpha unchanged
    // from the previous pixel.
    QoiOpRgb(r: Int, g: Int, b: Int)
    // `11111111` plus four bytes — a literal pixel including alpha.
    QoiOpRgba(r: Int, g: Int, b: Int, a: Int)

// The name of an opcode, for a message or an inspector's output.
//
// `index`, `diff`, `luma`, `run`, `rgb`, `rgba` — the specification's
// own spellings with the `QOI_OP_` prefix dropped.
//
// ```novo
// use qoiop
//
// fn main() [io]
//     println("${qoiop.op_name(QoiOpIndex(0))}")           // index
// ```
pub fn op_name(op: QoiOp) -> Str
    match op
        QoiOpIndex(_)         => "index"
        QoiOpDiff(_, _, _)    => "diff"
        QoiOpLuma(_, _, _)    => "luma"
        QoiOpRun(_)           => "run"
        QoiOpRgb(_, _, _)     => "rgb"
        QoiOpRgba(_, _, _, _) => "rgba"

// How many bytes an opcode occupies on the wire: 1, 2, 4 or 5.
//
// `QoiOpIndex`, `QoiOpDiff` and `QoiOpRun` are one byte; `QoiOpLuma`
// is two; `QoiOpRgb` is four and `QoiOpRgba` five.  A caller sizing a
// buffer or seeking past an opcode asks this rather than counting.
//
// ```novo
// use qoiop
//
// fn main() [io]
//     println("${qoiop.op_size(QoiOpRgba(0, 0, 0, 0))}")   // 5
// ```
pub fn op_size(op: QoiOp) -> Int
    match op
        QoiOpLuma(_, _, _)    => 2
        QoiOpRgb(_, _, _)     => 4
        QoiOpRgba(_, _, _, _) => 5
        _                     => 1

// How many pixels an opcode produces.
//
// One for everything except `QoiOpRun`, which produces its `run`.
//
// ```novo
// use qoiop
//
// fn main() [io]
//     println("${qoiop.op_pixels(QoiOpRun(7))}")           // 7
// ```
pub fn op_pixels(op: QoiOp) -> Int
    match op
        QoiOpRun(n) => n
        _           => 1

// The table position a pixel hashes to, `0 ..= 63`.
//
// `(r*3 + g*5 + b*7 + a*11) % 64`.  The multipliers are the
// specification's: an encoder and a decoder have to agree on them, so
// a better hash is not an improvement but a different format.
//
// ```novo
// use qoiop
// use srgb
//
// fn main() [io]
//     println("${qoiop.index_of(srgb.transparent())}")     // 0
// ```
pub fn index_of(px: Srgba8) -> Int
    hash(px.rgb.r, px.rgb.g, px.rgb.b, px.a)

// The sixty-four-entry table of recently seen pixels.
//
// A struct rather than a bare list, so that the seeding rule, every
// entry fully transparent, lives in `running_new`.
//
// The entries are color-nv's `Srgba8`, a plain struct, so each is a
// small heap cell.  That is why this package makes no claim to run on a
// microcontroller: an embedded build refuses a boxed struct literal.
//
// ```novo
// use qoiop
//
// fn main() [io]
//     println("${qoiop.running_len()}")                    // 64
// ```
pub struct QoiRunning
    // The table, always exactly sixty-four entries.
    seen: [Srgba8]

// A fresh table: sixty-four fully transparent pixels.
//
// Not opaque black: the previous pixel starts at opaque black and this
// table at (0,0,0,0), as the specification says.
//
// ```novo
// use qoiop
//
// fn main() [io]
//     println("${qoiop.recall(qoiop.running_new(), 0).a}") // 0
// ```
pub fn running_new() -> QoiRunning
    var seen: [Srgba8] = []
    for _ in 0..running_len()
        list.push(seen, srgb.transparent())
    QoiRunning { seen: seen }

// How many entries a running table has: 64, always.
//
// ```novo
// use qoiop
//
// fn main() [io]
//     println("${qoiop.running_len()}")                    // 64
// ```
pub fn running_len() -> Int
    64

// The table with a pixel written at its own hash position.
//
// A decoder writes every pixel it produces, one read out of the table
// included, which leaves the table as it was.
//
// ```novo
// use qoiop
// use srgb
//
// fn main() [io]
//     let t = qoiop.remember(qoiop.running_new(), srgb.opaque(srgb.white()))
//     println("${qoiop.recall(t, qoiop.index_of(srgb.opaque(srgb.white()))).a}")   // 255
// ```
pub fn remember(t: QoiRunning, px: Srgba8) -> QoiRunning
    var seen = list.clone(t.seen)
    seen[index_of(px)] = px
    QoiRunning { seen: seen }

// The pixel at a table position.
//
// `at` outside `0 ..= 63` panics.  A `QoiOpIndex` carries six bits and
// cannot name a position outside the table, so an index out of range is
// a caller's error rather than a corrupt file.
//
// ```novo
// use qoiop
//
// fn main() [io]
//     println("${qoiop.recall(qoiop.running_new(), 63).rgb.r}")    // 0
// ```
pub fn recall(t: QoiRunning, at: Int) -> Srgba8
    t.seen[at]

// The pixel an opcode produces, given the previous pixel and the
// table.
//
// `QoiOpRun` answers `prev`, the one pixel value it repeats;
// `op_pixels` is how many times.  Differences wrap at 256.
//
// ```novo
// use qoiop
// use srgb
//
// fn main() [io]
//     let px = qoiop.apply(QoiOpRun(4), srgb.opaque(srgb.white()), qoiop.running_new())
//     println("${px.rgb.r}")                               // 255
// ```
pub fn apply(op: QoiOp, prev: Srgba8, t: QoiRunning) -> Srgba8
    match op
        QoiOpIndex(at)        => recall(t, at)
        QoiOpDiff(dr, dg, db) => moved(prev, dr, dg, db)
        QoiOpLuma(dr, dg, db) => moved(prev, dr, dg, db)
        QoiOpRun(_)           => prev
        QoiOpRgb(r, g, b)     => Srgba8 { rgb: Srgb8 { r: r, g: g, b: b }, a: prev.a }
        QoiOpRgba(r, g, b, a) => Srgba8 { rgb: Srgb8 { r: r, g: g, b: b }, a: a }

// The shortest opcode that codes this pixel after that one.
//
// The specification fixes the answer: index if the table holds the
// pixel, then diff, then luma, then a literal, and a literal with alpha
// whenever alpha changes.  Channel differences wrap at 256, as they do
// in the reference encoder.
//
// Runs are not chosen here, since a run spans pixels and this function
// sees one; the encoder turns repeated pixels into runs.
//
// ```novo
// use qoiop
// use srgb
//
// fn main() [io]
//     let same = srgb.opaque(srgb.white())
//     println("${qoiop.op_name(qoiop.choose(same, same, qoiop.running_new()))}")   // diff
// ```
pub fn choose(px: Srgba8, prev: Srgba8, t: QoiRunning) -> QoiOp
    choose_packed(pack(px), pack(prev), srgb.same_pixel(recall(t, index_of(px)), px))

// Read one opcode out of a buffer at an offset.
//
// `None` when fewer bytes remain than the opcode needs, so a caller
// reading a file in chunks calls until it answers `None` and then
// fetches more.
//
// ```novo
// use qoiop
//
// fn main() [io]
//     match qoiop.read_op(bytes.zeros(0), 0)
//         Some(_) => println("read")
//         None    => println("nothing there")              // this one
// ```
pub fn read_op(src: Bytes, at: Int) -> ?QoiOp
    let b1 = bytes.byte_at(src, at) ?? 0 - 1
    if b1 < 0 or at + size_of_tag(b1) > bytes.len(src)
        return None
    Some(op_at(src, at, b1))

// Write one opcode into a caller-supplied buffer at an offset.
//
// The bytes are written into `out` itself, and the answer is that
// buffer and the offset past them.  A buffer too short for the opcode
// panics: a caller who sized it with `qoi.max_encoded_size` cannot
// reach that.
//
// ```novo
// use qoiop
//
// fn main() [io]
//     let (buf, at) = qoiop.write_op(QoiOpRun(1), bytes.zeros(8), 0)
//     println("${at}")                                     // 1
// ```
pub fn write_op(op: QoiOp, var out: Bytes, at: Int) -> (Bytes, Int)
    let n = op_size(op)
    if at + n > bytes.len(out)
        core.panic.panic("qoi-nv.qoiop.write_op: ${n} bytes do not fit at offset ${at} of ${bytes.len(out)}")
    match op
        QoiOpIndex(i)         => bytes.set_u8(out, at, i & 63)
        QoiOpDiff(dr, dg, db) =>
            bytes.set_u8(out, at, 64 | ((dr + 2) << 4) | ((dg + 2) << 2) | (db + 2))
        QoiOpLuma(dr, dg, db) =>
            bytes.set_u8(out, at, 128 | (dg + 32))
            bytes.set_u8(out, at + 1, ((dr - dg + 8) << 4) | (db - dg + 8))
        QoiOpRun(n1)          => bytes.set_u8(out, at, 192 | (n1 - 1))
        QoiOpRgb(r, g, b)     =>
            bytes.set_u8(out, at, 254)
            bytes.set_u8(out, at + 1, r)
            bytes.set_u8(out, at + 2, g)
            bytes.set_u8(out, at + 3, b)
        QoiOpRgba(r, g, b, a) =>
            bytes.set_u8(out, at, 255)
            bytes.set_u8(out, at + 1, r)
            bytes.set_u8(out, at + 2, g)
            bytes.set_u8(out, at + 3, b)
            bytes.set_u8(out, at + 4, a)
    (out, at + n)

// The table position of a pixel given as its four channels.
fn hash(r: Int, g: Int, b: Int, a: Int) -> Int
    (r * 3 + g * 5 + b * 7 + a * 11) % 64

// A pixel packed into one integer as `r g b a`, one byte each.  The
// decoder and the encoder keep their table and their previous pixel in
// this form, so that a pixel costs no allocation.
fn pack(px: Srgba8) -> Int
    (px.rgb.r << 24) | (px.rgb.g << 16) | (px.rgb.b << 8) | px.a

fn unpack(v: Int) -> Srgba8
    Srgba8 { rgb: Srgb8 { r: (v >> 24) & 255, g: (v >> 16) & 255, b: (v >> 8) & 255 },
             a: v & 255 }

fn hash_packed(v: Int) -> Int
    hash((v >> 24) & 255, (v >> 16) & 255, (v >> 8) & 255, v & 255)

// A channel difference as the reference encoder takes it: the byte
// difference wrapped into `-128 ..= 127`.
fn wrapped(now: Int, before: Int) -> Int
    (now - before + 384) % 256 - 128

// The pixel `prev` moved by three channel differences, each wrapping
// at 256, with alpha unchanged.
fn moved(prev: Srgba8, dr: Int, dg: Int, db: Int) -> Srgba8
    Srgba8 { rgb: Srgb8 { r: (prev.rgb.r + dr + 256) & 255, g: (prev.rgb.g + dg + 256) & 255,
                          b: (prev.rgb.b + db + 256) & 255 },
             a: prev.a }

// The opcode for a packed pixel after a packed previous pixel, once the
// table has been asked: `in_table` is whether the pixel's position
// holds it.  The order is the specification's: index, then diff, then
// luma, then a literal.
fn choose_packed(px: Int, prev: Int, in_table: Bool) -> QoiOp
    if in_table
        return QoiOpIndex(hash_packed(px))
    let r = (px >> 24) & 255
    let g = (px >> 16) & 255
    let b = (px >> 8) & 255
    let a = px & 255
    if a != (prev & 255)
        return QoiOpRgba(r, g, b, a)
    let dr = wrapped(r, (prev >> 24) & 255)
    let dg = wrapped(g, (prev >> 16) & 255)
    let db = wrapped(b, (prev >> 8) & 255)
    if dr >= 0 - 2 and dr <= 1 and dg >= 0 - 2 and dg <= 1 and db >= 0 - 2 and db <= 1
        return QoiOpDiff(dr, dg, db)
    let rg = dr - dg
    let bg = db - dg
    if dg >= 0 - 32 and dg <= 31 and rg >= 0 - 8 and rg <= 7 and bg >= 0 - 8 and bg <= 7
        return QoiOpLuma(dr, dg, db)
    QoiOpRgb(r, g, b)

// How many bytes the opcode whose first byte is `b1` occupies.
fn size_of_tag(b1: Int) -> Int
    if b1 == 254
        return 4
    if b1 == 255
        return 5
    if (b1 >> 6) == 2
        return 2
    1

// The opcode whose first byte `b1` is at `at` in `src`, which holds all
// of it.
fn op_at(src: Bytes, at: Int, b1: Int) -> QoiOp
    let tag = b1 >> 6
    if b1 == 254
        return QoiOpRgb(byte(src, at + 1), byte(src, at + 2), byte(src, at + 3))
    if b1 == 255
        return QoiOpRgba(byte(src, at + 1), byte(src, at + 2), byte(src, at + 3),
                         byte(src, at + 4))
    if tag == 0
        return QoiOpIndex(b1 & 63)
    if tag == 1
        return QoiOpDiff(((b1 >> 4) & 3) - 2, ((b1 >> 2) & 3) - 2, (b1 & 3) - 2)
    if tag == 2
        let dg = (b1 & 63) - 32
        let b2 = byte(src, at + 1)
        return QoiOpLuma(dg + ((b2 >> 4) & 15) - 8, dg, dg + (b2 & 15) - 8)
    QoiOpRun((b1 & 63) + 1)

fn byte(src: Bytes, i: Int) -> Int
    bytes.byte_at(src, i) ?? 0
