// differential_tests.nv — this codec against the Python reference
// codec in tools/qoiref.py.
//
// Written by `python3 tools/qoiref.py differential`.  Each case is a
// small image, generated from a fixed seed to exercise one part of the
// format (noise, steps a diff codes, gradients a luma codes, runs, a
// small palette the index reuses, and differences that wrap at 256),
// and the file the Python encoder wrote for it.  This encoder has to
// write the same bytes, and this decoder has to read them back to the
// same pixels.

use std.test
use qoidec
use qoienc

fn agrees(w: Int, h: Int, channels: Int, pixels_hex: Str, qoi_hex: Str) -> Bool
    let pixels = bytes.from_hex(pixels_hex) ?? bytes.zeros(0)
    let file = bytes.from_hex(qoi_hex) ?? bytes.zeros(0)
    let chans = if channels == 3
        QoiRgb
    else
        QoiRgba
    let space = if channels == 3
        QoiSrgbLinearAlpha
    else
        QoiAllLinear
    let h1 = QoiHeader { width: w, height: h, channels: chans, space: space }
    match qoidec.decode(file)
        Ok((head, back)) =>
            head.width == w and head.height == h and back == pixels
                and qoienc.encode(h1, pixels) == Ok(file)
        Err(_)           => false

@test
fn test_the_codec_agrees_with_the_python_reference() [io]
    test.case("noise, 8 by 8, 3 channels")
    test.assert(agrees(8, 8, 3,
                       "",
                       ""))
    test.case("noise, 19 by 4, 4 channels")
    test.assert(agrees(19, 4, 4,
                       "",
                       ""))
    test.case("steps, 18 by 5, 3 channels")
    test.assert(agrees(18, 5, 3,
                       "",
                       "716f696600000012000000050300fea1b86e5d4d6364687e50786e447876697a4465586264664352715c7c494c6c69624b7a50766d6d575f50425d444f724c594a547b41716f746e4c4e4e4f79705a584e74c045744e7c444d5369754e76565a6844786c71444074434b5a0000000000000001"))
    test.case("steps, 16 by 11, 4 channels")
    test.assert(agrees(16, 11, 4,
                       "",
                       ""))
    test.case("gradient, 5 by 4, 3 channels")
    test.assert(agrees(5, 4, 3,
                       "ee11cdf515d6d6fcc4b7e1a2b8e6a8afdd9da1cd858cbd7a8bbc727cb26897d0889ed291b0dd98cffbb3bbe29da1c27cbce1a1a3c78389a960abc478",
                       "716f696600000005000000040300feee11cda4bd872f8541a549978690a0903d9f819638be5aa2dfabf4be9587db80e7bf4e869482c3bbf50000000000000001"))
    test.case("gradient, 9 by 5, 4 channels")
    test.assert(agrees(9, 5, 4,
                       "",
                       "716f696600000009000000050401ff28d42f6d9d4396a7b99a8a31b05786c6aed8912eb7ddb39bb1c2b26992eca405a974b40dab98b3129352adc495f597c091bf8f45b011ac1993a5b7699e12a6bbaf069d2bb2b08c0d922b934e8c0487798c76b62c89368ef8a38ab69f0000000000000001"))
    test.case("runs, 6 by 8, 3 channels")
    test.assert(agrees(6, 8, 3,
                       "296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6f296c6ffd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936fd6936",
                       "716f696600000006000000080300fe296c6fd6fefd6936d60000000000000001"))
    test.case("runs, 1 by 11, 4 channels")
    test.assert(agrees(1, 11, 4,
                       "57668eff57668eff57668eff57668eff57668eff2af8beff2af8beff2af8beff2b83feff2b83feff0ea7b4ff",
                       "716f6966000000010000000b0401fe57668ec3fe2af8bec1fe2b83fec0fe0ea7b40000000000000001"))
    test.case("palette, 16 by 7, 3 channels")
    test.assert(agrees(16, 7, 3,
                       "",
                       "716f696600000010000000070300c0557f5aa12a263dc0323d3235fe0ac81e26c10d3d32350d352635c03dc00d2635c00d3d3526c03d3526c00d350d32c035c032c0260d350d35c0263235c026c03d260d2635c23d32352635c10d353d32350d3d0d260d263d35c00dc032c035c03226353235c032c0353d32353dc00d3d0000000000000001"))
    test.case("palette, 18 by 6, 4 channels")
    test.assert(agrees(18, 6, 4,
                       "",
                       ""))
    test.case("wrap, 3 by 2, 3 channels")
    test.assert(agrees(3, 2, 3,
                       "0001fe00000001fefefeff00fe00fe0100ff",
                       "716f6966000000030000000203006c9f9b70a1496ca0b90000000000000001"))
    test.case("wrap, 15 by 7, 4 channels")
    test.assert(agrees(15, 7, 4,
                       "",
                       ""))
    test.case("run of 61, 62 by 1, 4 channels")
    test.assert(agrees(62, 1, 4,
                       "",
                       "716f69660000003e000000010401fca6790000000000000001"))
    test.case("run of 62, 63 by 1, 4 channels")
    test.assert(agrees(63, 1, 4,
                       "",
                       "716f69660000003f000000010401fda6790000000000000001"))
    test.case("run of 63, 64 by 1, 4 channels")
    test.assert(agrees(64, 1, 4,
                       "",
                       "716f696600000040000000010401fdc0a6790000000000000001"))
    test.case("run of 124, 125 by 1, 4 channels")
    test.assert(agrees(125, 1, 4,
                       "",
                       "716f69660000007d000000010401fdfda6790000000000000001"))
    test.case("run of 125, 126 by 1, 4 channels")
    test.assert(agrees(126, 1, 4,
                       "",
                       "716f69660000007e000000010401fdfdc0a6790000000000000001"))
